rules_version = '2';

// Reglas de seguridad de Cloud Firestore.
// Se copian en Firebase Console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Denegar todo por defecto.
    match /{document=**} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Documento existente (read / update / delete): resource.data
      function isOwnerExisting() {
        return isSignedIn() && request.auth.uid == resource.data.userId;
      }

      // Datos propuestos (create / update): request.resource.data
      function isOwnerIncoming() {
        return isSignedIn() && request.auth.uid == request.resource.data.userId;
      }

      function hasValidShape() {
        let data = request.resource.data;
        return data.keys().hasAll(['title', 'description', 'completed', 'userId', 'priority', 'order'])
          && data.keys().hasOnly(['title', 'description', 'completed', 'userId', 'createdAt', 'priority', 'dueDate', 'order'])
          && data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && data.description is string && data.description.size() <= 200
          && data.completed is bool
          && data.userId is string
          && data.priority in ['low', 'medium', 'high']
          && (!('dueDate' in data) || data.dueDate == null || data.dueDate is string)
          && data.order is number;
      }

      allow get, list: if isOwnerExisting();
      allow create: if isOwnerIncoming() && hasValidShape();
      allow update: if isOwnerExisting()
        && request.resource.data.userId == resource.data.userId
        && hasValidShape();
      allow delete: if isOwnerExisting();
    }
  }
}
